rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // ANTI-CHEAT, NO CLOUD FUNCTIONS (Spark / free plan)
    //
    // Cloud Functions need the paid Blaze plan, so there's no server-side code
    // in front of these writes. Instead, these rules do the validation
    // directly: `request.time` is a server-set timestamp the client can't
    // forge, and rules can read the PREVIOUS document (`resource.data`) to
    // compute real elapsed time and bound how much totalEarned/weeklyEarned
    // are allowed to grow given the player's own reported income rate. This
    // is genuinely stronger than a static "cash < some big number" cap — it
    // catches "set cash to 50 million two minutes into a new save", not just
    // "paste MAX_SAFE_INTEGER into devtools".
    //
    // Still an honest limitation: `ratePerSec` is itself client-reported. A
    // determined attacker who fabricates a fully self-consistent fake state
    // (including a fake rate) that ramps up gradually could still get
    // through. See SECURITY.md for the full writeup, the exact tunables
    // below, and what a Cloud Function would add if that's affordable later
    // (functions/index.js already has one written, just not deployed).
    // =========================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ---------- Leaderboard (scores, friend codes, guild tags) ----------
    function leaderboardShapeOk(d) {
      return d.name is string && d.name.size() <= 40
        && d.code is string && d.code.size() <= 8
        && d.cash is number && d.cash >= 0 && d.cash < 1e18
        && d.totalEarned is number && d.totalEarned >= 0 && d.totalEarned < 1e18
        && d.weeklyEarned is number && d.weeklyEarned >= 0 && d.weeklyEarned < 1e16
        && d.prestigePoints is number && d.prestigePoints >= 0 && d.prestigePoints < 100000
        && d.prestigeCount is number && d.prestigeCount >= 0 && d.prestigeCount < 100000
        && d.ratePerSec is number && d.ratePerSec >= 0 && d.ratePerSec < 1e12
        // updatedAt MUST be the server's own timestamp for this request —
        // a client can't backdate/forward-date it to game the elapsed-time
        // check on the NEXT write.
        && d.updatedAt == request.time;
    }

    function validLeaderboardGrowth() {
      let prev = resource.data;
      let next = request.resource.data;
      let prevAt = ('updatedAt' in prev) ? prev.updatedAt.toMillis() : 0;
      let elapsedSec = (request.time.toMillis() - prevAt) / 1000.0;
      let prevRate = ('ratePerSec' in prev) ? prev.ratePerSec : 0.0;
      let rateCeiling = (next.ratePerSec > prevRate ? next.ratePerSec : prevRate) > 5.0
        ? (next.ratePerSec > prevRate ? next.ratePerSec : prevRate)
        : 5.0;
      let maxGrowth = elapsedSec * rateCeiling * 6.0 + 2000.0;
      let prevTotal = ('totalEarned' in prev) ? prev.totalEarned : 0.0;
      let prevWeekly = ('weeklyEarned' in prev) ? prev.weeklyEarned : 0.0;
      let prevPrestigePoints = ('prestigePoints' in prev) ? prev.prestigePoints : 0.0;
      let prevPrestigeCount = ('prestigeCount' in prev) ? prev.prestigeCount : 0.0;
      let prevWeekId = ('weekId' in prev) ? prev.weekId : null;
      let prestiged = next.prestigeCount > prevPrestigeCount;
      let sameWeek = prevWeekId == next.weekId;

      return elapsedSec >= 25.0 // matches the client's own 30s throttle, minus slack
        && (next.prestigeCount - prevPrestigeCount) >= 0
        && (next.prestigeCount - prevPrestigeCount) <= 20 // sanity cap — nobody legitimately prestiges 20+ times in one submit window
        && (prestiged
              // Prestiging zeroes totalEarned client-side; allow a little
              // grace for earnings made right after the reset.
              ? next.totalEarned <= 2000.0
              : (next.totalEarned >= prevTotal - 1.0 && (next.totalEarned - prevTotal) <= maxGrowth))
        && (sameWeek
              ? (next.weeklyEarned >= prevWeekly - 1.0 && (next.weeklyEarned - prevWeekly) <= maxGrowth)
              : next.weeklyEarned <= maxGrowth)
        && next.prestigePoints >= prevPrestigePoints - 0.000001; // Miso Points may never decrease
    }

    match /leaderboard/{uid} {
      allow read: if isSignedIn();
      allow delete: if isOwner(uid); // self-serve removal is fine — it doesn't let you write false data

      // First-ever submission has no prior doc to compare elapsed time
      // against. Bound it with a flat, generous-but-not-huge cap instead —
      // enough for genuine fast/lucky early play, nowhere near "type a
      // huge number into devtools".
      allow create: if isOwner(uid)
        && leaderboardShapeOk(request.resource.data)
        && request.resource.data.cash <= 500000
        && request.resource.data.totalEarned <= 500000
        && request.resource.data.weeklyEarned <= 500000
        && request.resource.data.prestigeCount == 0
        && request.resource.data.prestigePoints == 0;

      allow update: if isOwner(uid)
        && leaderboardShapeOk(request.resource.data)
        && validLeaderboardGrowth();
    }

    // ---------- Friends (one-way follow list) ----------
    match /friends/{uid} {
      allow read, write: if isOwner(uid);
    }

    // ---------- Weekly season champions ----------
    match /leaderboardSeasons/{weekId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(['uid', 'name', 'weeklyEarned']);
      allow update, delete: if false;
    }

    // ---------- Guilds / clans ----------
    // Creating/joining/leaving a guild still happens directly from the
    // client (membership manipulation isn't a score-integrity issue the
    // same way weeklyContrib is) — those updates are constrained to
    // well-formed, one-member-at-a-time diffs below. The actual
    // competitive number, weeklyContrib, can ONLY change through
    // validGuildContribution(), which cross-checks against each member's
    // own single-writer memberProgress doc (rate/growth bounded exactly
    // like the leaderboard above) — so no update branch other than that
    // one may touch weeklyContrib or weekId.
    function validGuildContribution(guildId) {
      let uid = request.auth.uid;
      let prevGuild = resource.data;
      let nextGuild = request.resource.data;
      let progress = get(/databases/$(database)/documents/guilds/$(guildId)/memberProgress/$(uid)).data;
      let prevAt = ('updatedAt' in progress) ? progress.updatedAt.toMillis() : 0;
      let elapsedSec = (request.time.toMillis() - prevAt) / 1000.0;
      let rate = ('ratePerSec' in progress) ? progress.ratePerSec : 0.0;
      let rateCeiling = rate > 5.0 ? rate : 5.0;
      let maxGrowth = elapsedSec * rateCeiling * 6.0 + 2000.0;
      let sameWeek = prevGuild.weekId == nextGuild.weekId;
      let claimedDelta = sameWeek ? (nextGuild.weeklyContrib - prevGuild.weeklyContrib) : nextGuild.weeklyContrib;

      return uid in prevGuild.members
        && uid in nextGuild.members
        && nextGuild.members == prevGuild.members
        && nextGuild.name == prevGuild.name
        && nextGuild.code == prevGuild.code
        && nextGuild.ownerUid == prevGuild.ownerUid
        && elapsedSec >= 55.0 // matches the client's own 60s throttle, minus slack
        && claimedDelta >= 1.0
        && claimedDelta <= maxGrowth;
    }

    match /guilds/{guildId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.members is list
        && request.resource.data.members.size() == 1
        && request.auth.uid in request.resource.data.members
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 20
        && request.resource.data.code is string
        && request.resource.data.code.size() <= 8
        // A brand-new guild must start at zero contribution.
        && (!('weeklyContrib' in request.resource.data) || request.resource.data.weeklyContrib == 0);

      allow update: if isSignedIn()
        && (
          // Joining: only adding yourself to members
          (
            request.auth.uid in request.resource.data.members
            && !(request.auth.uid in resource.data.members)
            && request.resource.data.members.size() == resource.data.members.size() + 1
            && request.resource.data.members.size() <= 10
            && request.resource.data.name == resource.data.name
            && request.resource.data.code == resource.data.code
            && request.resource.data.weeklyContrib == resource.data.weeklyContrib
            && request.resource.data.weekId == resource.data.weekId
          )
          // Leaving: only removing yourself
          || (
            !(request.auth.uid in request.resource.data.members)
            && request.auth.uid in resource.data.members
            && request.resource.data.members.size() == resource.data.members.size() - 1
            && request.resource.data.weeklyContrib == resource.data.weeklyContrib
            && request.resource.data.weekId == resource.data.weekId
          )
          // Member still in guild (e.g. owner transfer) — name/code/
          // ownerUid can move, but weeklyContrib/weekId never can here.
          || (
            request.auth.uid in resource.data.members
            && request.auth.uid in request.resource.data.members
            && request.resource.data.members == resource.data.members
            && request.resource.data.weeklyContrib == resource.data.weeklyContrib
            && request.resource.data.weekId == resource.data.weekId
          )
          // Contribution: the ONLY path that may change weeklyContrib/weekId.
          || validGuildContribution(guildId)
        );

      allow delete: if isSignedIn()
        && resource.data.ownerUid == request.auth.uid;

      // Per-member ground truth for contributeToGuild — single-writer
      // (only the member themselves), so rate/growth checks here can't be
      // confused by other members contributing at the same time.
      match /memberProgress/{uid} {
        allow read: if isSignedIn();

        allow create: if isOwner(uid)
          && request.resource.data.weeklyEarned is number
          && request.resource.data.weeklyEarned >= 0
          && request.resource.data.weeklyEarned < 1e16
          && request.resource.data.ratePerSec is number
          && request.resource.data.ratePerSec >= 0
          && request.resource.data.ratePerSec < 1e12
          && request.resource.data.updatedAt == request.time;

        allow update: if isOwner(uid)
          && request.resource.data.weeklyEarned is number
          && request.resource.data.weeklyEarned >= 0
          && request.resource.data.weeklyEarned < 1e16
          && request.resource.data.ratePerSec is number
          && request.resource.data.ratePerSec >= 0
          && request.resource.data.ratePerSec < 1e12
          && request.resource.data.updatedAt == request.time
          // no-op refreshes (weekId rolled, or delta < 1) are always fine;
          // real regressions within the same week are not.
          && (request.resource.data.weekId != resource.data.weekId
              || request.resource.data.weeklyEarned >= resource.data.weeklyEarned - 1.0);

        allow delete: if false;
      }
    }

    // ---------- Gifts (daily friend gifts) ----------
    match /gifts/{uid}/inbox/{giftId} {
      allow read, delete: if isOwner(uid);

      allow create: if isSignedIn()
        && request.auth.uid != uid
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 1000000000000000
        && request.resource.data.fromName is string
        && request.resource.data.fromName.size() <= 40;

      allow update: if false;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
