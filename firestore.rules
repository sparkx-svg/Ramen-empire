rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isValidName(name) {
      return name is string && name.size() >= 1 && name.size() <= 32;
    }
    function isValidCode(code) {
      return code is string && code.size() >= 4 && code.size() <= 8;
    }
    // Hard sanity bounds — stops the most obvious cheats from ever appearing
    function reasonableCash(c) {
      return c is number && c >= 0 && c < 1e18;
    }
    function reasonablePrestige(p) {
      return p is number && p >= 0 && p < 100000;
    }
    function reasonableWeekly(w) {
      return w is number && w >= 0 && w < 1e16;
    }

    // ---------- Leaderboard ----------
    // Players can only write their OWN document.
    // Bounds stop trillionaire cheats from landing on the board.
    match /leaderboard/{uid} {
      allow read: if true;

      allow create, update: if isOwner(uid)
        && isValidName(request.resource.data.get('name', 'Anonymous'))
        && reasonableCash(request.resource.data.get('cash', 0))
        && reasonableCash(request.resource.data.get('totalEarned', 0))
        && reasonableWeekly(request.resource.data.get('weeklyEarned', 0))
        && reasonablePrestige(request.resource.data.get('prestigePoints', 0));

      allow delete: if isOwner(uid);
    }

    // Season champions — nobody can write from the client
    match /leaderboardSeasons/{weekId} {
      allow read: if true;
      allow write: if false;
    }

    // ---------- Friends ----------
    match /friends/{uid} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid);
    }

    // ---------- Guilds ----------
    match /guilds/{guildId} {
      allow read: if true;

      allow create: if isSignedIn()
        && isValidName(request.resource.data.name)
        && isValidCode(request.resource.data.code)
        && request.resource.data.members is list
        && request.resource.data.members.size() == 1
        && request.auth.uid in request.resource.data.members
        && request.resource.data.owner == request.auth.uid;

      allow update: if isSignedIn()
        && request.auth.uid in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['members', 'memberNames', 'weeklyContrib', 'weekId', 'lastContribAt']);

      allow delete: if isSignedIn()
        && request.auth.uid == resource.data.owner;
    }

    // Everything else denied
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
